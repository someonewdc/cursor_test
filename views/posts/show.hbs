<!DOCTYPE html>
<html lang="en">
  <head>
    {{> head}}
  </head>
  <body>
    <header>
      <p><a href="/">Blog</a></p>
    </header>
    <main>
      <article>
        <h1>{{post.title}}</h1>
        <time datetime="{{post.createdAtIso}}">{{post.createdAt}}</time>
        <div class="body">{{post.body}}</div>
        <p><a href="/posts/{{post.id}}/edit">Edit</a></p>
      </article>
    </main>
    {{> footer}}
  </body>
</html>
