<!DOCTYPE html>
<html lang="en">
  <head>
    {{> head}}
  </head>
  <body>
    <header>
      <p><a href="/">Blog</a></p>
    </header>
    <main>
      <article>
        <h1>{{post.title}}</h1>
        <time datetime="{{post.createdAtIso}}">{{post.createdAt}}</time>
        <div class="body">{{post.body}}</div>
        <p class="post-actions">
          <a href="/posts/{{post.id}}/edit">Edit</a>
          <button
            type="button"
            hx-delete="/posts/{{post.id}}"
            hx-confirm="Delete this post?"
          >
            Delete
          </button>
        </p>
      </article>
      <section class="comments-section">
        <h2>Comments</h2>
        <div id="comments">
          {{> comments}}
        </div>
        <form
          class="comment-form"
          hx-post="/posts/{{post.id}}/comments"
          hx-target="#comments"
          hx-swap="innerHTML"
          hx-on::after-request="if(event.detail.successful) this.reset()"
        >
          <div>
            <label for="comment-body">Comment</label>
            <textarea id="comment-body" name="body"></textarea>
          </div>
          <button type="submit">Add comment</button>
        </form>
      </section>
    </main>
    {{> footer}}
  </body>
</html>
